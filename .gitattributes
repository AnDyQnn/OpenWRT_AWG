# Нормализация переносов строк: по умолчанию — авто
* text=auto

# Скрипты и CGI запускаются на Linux/OpenWRT — строго LF
*.sh        text eol=lf
install.sh  text eol=lf

# CGI-обработчики без расширения — тоже LF
www/cgi-bin/awg_upload      text eol=lf
www/cgi-bin/awg_status      text eol=lf
www/cgi-bin/awg_control     text eol=lf
docker/files/10-awg-setup   text eol=lf

# Текстовые файлы проекта
*.md        text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.conf      text eol=lf
LICENSE     text eol=lf
.gitignore  text eol=lf

# Бинарники — не трогать вообще
*.img       binary
*.img.gz    binary
*.gz        binary
*.zip       binary
*.tar       binary
*.bin       binary
