#!/bin/bash
# Консольный дашборд состояния шлюза. Запускать: gateway-status или watch -n2 gateway-status

B='\033[1m'; C='\033[0;36m'; G='\033[0;32m'; Y='\033[1;33m'; R='\033[0;31m'; DIM='\033[2m'; NC='\033[0m'
LINE="─────────────────────────────────────────────────────────"

header() { echo -e "${C}${B}╔${LINE}╗${NC}"; printf "${C}${B}║  %-53s║${NC}\n" "$1"; echo -e "${C}${B}╚${LINE}╝${NC}"; }
row()    { printf "  ${B}%-14s${NC} %s\n" "$1" "$2"; }

clear
echo ""
header "  Gateway Linux — $(hostname)  $(date '+%Y-%m-%d %H:%M')"

# ── Система ──────────────────────────────────────────────────────
echo -e "\n${B}  СИСТЕМА${NC}"
UPTIME=$(awk '{d=int($1/86400);h=int($1%86400/3600);m=int($1%3600/60); printf "%dd %dh %dm",d,h,m}' /proc/uptime)
CPU_CORES=$(nproc)
LOAD=$(awk '{printf "%.1f",$1}' /proc/loadavg)
CPU_PCT=$(awk -v l=$LOAD -v c=$CPU_CORES 'BEGIN{v=int(l/c*100);if(v>100)v=100;print v}')
MEM_T=$(awk '/MemTotal:/{print int($2/1024)}' /proc/meminfo)
MEM_A=$(awk '/MemAvailable:/{print int($2/1024)}' /proc/meminfo)
MEM_U=$((MEM_T-MEM_A))
row "Uptime" "$UPTIME"
row "CPU" "${CPU_PCT}%  (load: $(cut -d' ' -f1-3 /proc/loadavg))"
row "RAM" "${MEM_U}/${MEM_T} МБ  (свободно: ${MEM_A} МБ)"

# ── Сеть ─────────────────────────────────────────────────────────
echo -e "\n${B}  СЕТЬ${NC}"
WAN=$(cat /run/awg-setup/wan-port 2>/dev/null || cat /etc/awg-setup/wan-port 2>/dev/null || echo "?")
WAN_IP=$(ip -4 addr show "$WAN" 2>/dev/null | awk '/inet /{print $2}' | head -1)
LAN_IP=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | head -1 || echo "192.168.88.1/24")
LEASES=/var/lib/misc/dnsmasq.leases
[ -f "$LEASES" ] && DEVICES=$(wc -l < "$LEASES" 2>/dev/null | tr -d ' '); [ -z "$DEVICES" ] && DEVICES=0

row "WAN порт" "${WAN}  IP: ${WAN_IP:-нет адреса}"
row "LAN (br-lan)" "${LAN_IP}  Устройств: ${DEVICES}"

# ── VPN ──────────────────────────────────────────────────────────
echo -e "\n${B}  VPN (AmneziaWG)${NC}"
MODE=$(cat /run/awg-mode 2>/dev/null || echo "no_config")
case "$MODE" in
    vpn)        STATUS="${G}ПОДКЛЮЧЁН${NC}" ;;
    fallback)   STATUS="${Y}FAILOVER (прямой интернет)${NC}" ;;
    manual_off) STATUS="${DIM}ВЫКЛЮЧЕН вручную${NC}" ;;
    no_config)  STATUS="${DIM}НЕТ КОНФИГА${NC}" ;;
    *)          STATUS="${R}${MODE}${NC}" ;;
esac
row "Режим" "$(echo -e $STATUS)"

if ip link show awg0 >/dev/null 2>&1; then
    AWG_OUT=$(docker exec gw-awg awg show awg0 2>/dev/null || awg show awg0 2>/dev/null || echo "")
    ENDPOINT=$(echo "$AWG_OUT" | awk '/endpoint:/{print $2}')
    TRANSFER=$(echo "$AWG_OUT" | sed -n 's/.*transfer: //p')
    HS_TS=$(docker exec gw-awg awg show awg0 latest-handshakes 2>/dev/null | awk '{print $2}')
    if [ -n "$HS_TS" ] && [ "$HS_TS" -gt 0 ] 2>/dev/null; then
        AGE=$(( $(date +%s) - HS_TS ))
        row "Хэндшейк" "${AGE}с назад"
    fi
    [ -n "$ENDPOINT"  ] && row "Endpoint" "$ENDPOINT"
    [ -n "$TRANSFER"  ] && row "Трафик"   "$TRANSFER"
fi

# ── Docker контейнеры ────────────────────────────────────────────
echo -e "\n${B}  КОНТЕЙНЕРЫ${NC}"
if command -v docker >/dev/null 2>&1; then
    docker ps -a --format "  {{.Names}}\t{{.Status}}\t{{.Image}}" 2>/dev/null | \
        awk -F'\t' '{printf "  %-16s %-30s %s\n", $1, $2, $3}' || echo "  Docker не запущен"

    # Если контейнер не «Up» (упал/перезапускается) — показываем причину прямо здесь,
    # чтобы её было видно на экране без доступа к docker logs.
    for cn in $(docker ps -a --format '{{.Names}} {{.Status}}' 2>/dev/null \
                | awk '$2!~/^Up/{print $1}'); do
        echo -e "  ${R}↳ $cn не запущен — последние строки лога:${NC}"
        docker logs "$cn" --tail 6 2>&1 | sed 's/^/      /'
    done
else
    echo "  Docker не установлен"
fi

# ── DHCP аренды ──────────────────────────────────────────────────
LEASES="/var/lib/misc/dnsmasq.leases"
if [ -f "$LEASES" ] && [ -s "$LEASES" ]; then
    echo -e "\n${B}  DHCP АРЕНДЫ${NC}"
    awk '{printf "  %-16s %-20s %s\n", $3, $2, $4}' "$LEASES"
fi

# ── Логи (последние события) ─────────────────────────────────────
WLOG="/var/log/awg-watchdog.log"
if [ -f "$WLOG" ]; then
    echo -e "\n${B}  ПОСЛЕДНИЕ СОБЫТИЯ${NC}"
    tail -5 "$WLOG" | while IFS= read -r line; do
        case "$line" in
            *" OK "*) echo -e "  ${G}$line${NC}" ;;
            *" WARN "*) echo -e "  ${Y}$line${NC}" ;;
            *" ERR "*) echo -e "  ${R}$line${NC}" ;;
            *) echo -e "  ${DIM}$line${NC}" ;;
        esac
    done
fi

echo ""
echo -e "${DIM}  Обновить: gateway-status  │  Авто: watch -n3 gateway-status${NC}"
echo ""
